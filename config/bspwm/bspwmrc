#!/usr/bin/env sh
# bspwmrc — kali-nordic. La PRIMERA línea usable es el teclado español (sección 13.4).

# 1) Teclado español SIEMPRE, en cada inicio de sesión
setxkbmap es &

# 2) Directorios de sesión
[ -x "$HOME/.local/bin" ] || mkdir -p "$HOME/.local/bin"
mkdir -p /run/nordic 2>/dev/null || true

# 3) Base bspwm
bspc config pointer_modifier ~mod1 &
bspc config border_width        3
bspc config window_gap          14
bspc config top_padding         44
bspc config left_padding        12
bspc config right_padding       12
bspc config bottom_padding      12
bspc config split_ratio         0.52
bspc config borderless_monocle  true
bspc config gapless_monocle     true
bspc config single_monocle      false
bspc config remove_disabled_monitors false
bspc config ignore_ewmh_fullscreen     true
bspc config ignore_ewmh_focus          false
bspc config focus_follows_pointer      true
bspc config click_to_focus             any
bspc config suggest_gapless_children   false

# Colores de borde: Frost para la enfocada, Polar Night para el resto
bspc config normal_border_color   "#4C566A"
bspc config active_border_color   "#4C566A"
bspc config focused_border_color  "#434C5E"   # sutil: el vidrio ya marca la ventana activa
bspc config presel_border_color   "#81A1C1"
bspc config locked_border_color   "#BF616A"
bspc config sticky_border_color   "#B48EAD"
bspc config urgent_border_color   "#EBCB8B"

# 4) Escritorios 1-9
bspc monitor -a I II III IV V VI VII VIII IX X
bspc desktop Desktop -r 2>/dev/null || true   # quitar el escritorio default
bspc desktop -m "^1" layout monocle 2>/dev/null || true

# 5) Reglas de ventanas (sección 8.1)
bspc rule -a Zathura state=tiled
bspc rule -a Gimp:toolbox state=floating follow=on
bspc rule -a Gimp-2.10 state=floating
bspc rule -a Screenkey:manageable state=floating
bspc rule -a Pavucontrol state=floating center=true
bspc rule -a 'org.gnome.Nautilus' state=floating center=true
bspc rule -a Emacs state=tiled
bspc rule -a Xarchiver state=floating
bspc rule -a File-roller state=floating center=true
bspc rule -a Arandr state=floating
bspc rule -a "Rofi" state=floating center=true border=false
bspc rule -a "rofi" state=floating center=true border=false
bspc rule -a virt-manager state=floating center=true
bspc rule -a burp-#burp-Pro floating=on follow=on desktop='^4'
bspc rule -a Wireshark desktop='^5' follow=on
bspc rule -a "firefox" desktop='^2'
bspc rule -a "Firefox" desktop='^2'
bspc rule -a "Google-chrome" desktop='^2'
bspc rule -a "Chromium" desktop='^2'
bspc rule -a "xev" state=floating
bspc rule -a "plasmashell" state=floating

# Barra: no la gestiona bspwm (si no, la "tileda" en otro escritorio y desaparece)
bspc rule -a Polybar state=floating border=off sticky=on managed=off

# 6) Escritorios dedicados (web/código/notas/red/mensajería) con nombres para la barra
: # los nombres los pinta polybar vía iconos sobre 1-9

# 7) Autostart de sesión (en paralelo, respawn manejado por autostart.sh)
sh "$HOME"/.config/bspwm/autostart.sh &   # con sh: no depende de +x tras scp/rsync

# 8) Auto-equilibrado del árbol al abrir/cerrar (sección 8.1)
(
  bspc subscribe node_add node_remove 2>/dev/null | while read -r ev _rest; do
    case "$ev" in node_add|node_remove)
      [ "$(bspc query -D -d . --count 2>/dev/null)" = "0" ] || true
      for d in $(bspc query -D --names); do
        n=$(bspc query -N -d "$d" 2>/dev/null | grep -c .)
        [ "$n" -gt 1 ] && [ "$((n % 2))" -eq 0 ] && bspc desktop "$d" --balance 2>/dev/null
      done
      ;;
    esac
  done
) &
